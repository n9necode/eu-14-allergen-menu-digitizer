{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EU-14 Allergen Menu Digitizer Input",
  "type": "object",
  "schemaVersion": 1,
  "required": ["menuImageUrls", "geminiApiKey"],
  "properties": {
    "menuImageUrls": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of URLs to menu images or PDFs. Required."
    },
    "geminiApiKey": {
      "type": "string",
      "description": "User's own Gemini API key. The user supplies their own key."
    },
    "outputLanguage": {
      "type": "string",
      "default": "en",
      "description": "Language for translated dish names and ingredient display names."
    },
    "sourceLanguageHint": {
      "type": "string",
      "description": "Optional hint for non-Latin script menus (e.g., 'zh', 'ja', 'ar')."
    },
    "cuisineVertical": {
      "type": "string",
      "enum": ["italian", "indian", "japanese", "mexican", "general"],
      "default": "general",
      "description": "Cuisine-specific allergen keyword override map."
    },
    "maxPagesPerPdf": {
      "type": "integer",
      "default": 10,
      "description": "Cap on PDF pages rendered."
    }
  },
  "additionalProperties": false
}