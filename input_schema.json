{
  "title": "EU-14 Allergen Menu Digitizer",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "menuImageUrls": {
      "title": "Menu Image URLs",
      "type": "array",
      "description": "URLs of menu images or PDFs to extract dishes from.",
      "editor": "stringList",
      "items": {
        "type": "string"
      }
    },
    "geminiApiKey": {
      "title": "Gemini API Key",
      "type": "string",
      "description": "Your Google Gemini API key (BYOK).",
      "editor": "textfield",
      "isSecret": true
    },
    "outputLanguage": {
      "title": "Output Language",
      "type": "string",
      "description": "Language for translated dish names.",
      "editor": "textfield",
      "default": "en"
    },
    "sourceLanguageHint": {
      "title": "Source Language Hint",
      "type": "string",
      "description": "Optional. Helps OCR if the menu is in a non-Latin script.",
      "editor": "textfield"
    },
    "cuisineVertical": {
      "title": "Cuisine Vertical",
      "type": "string",
      "description": "Loads cuisine-specific allergen keyword overrides.",
      "editor": "select",
      "default": "general",
      "enum": ["general", "italian", "indian", "japanese", "mexican"],
      "enumTitles": ["General", "Italian", "Indian", "Japanese", "Mexican"]
    },
    "maxPagesPerPdf": {
      "title": "Max Pages Per PDF",
      "type": "integer",
      "description": "Cap on PDF pages rendered.",
      "editor": "number",
      "default": 10
    },
    "jurisdiction": {
      "title": "Jurisdiction",
      "type": "string",
      "description": "Allergen framework to apply (EU-14 or US-9).",
      "editor": "select",
      "default": "EU",
      "enum": ["EU", "US-CA"],
      "enumTitles": ["EU (14 allergens)", "US-CA (9 allergens)"]
    }
  },
  "required": ["menuImageUrls", "geminiApiKey"]
}